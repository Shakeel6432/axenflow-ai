generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String          @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  company         String?
  country         String?
  notifyProduct   Boolean         @default(true) @map("notify_product")
  notifyMarketing Boolean         @default(false) @map("notify_marketing")
  /** Legacy lead credits column still present in production DB */
  leadCredits     Int             @default(50) @map("lead_credits")
  role            UserRole        @default(USER)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  accounts        Account[]
  sessions        Session[]
  searchHistory   SearchHistory[]
  downloads       Download[]
  savedLeads      SavedLead[]
  exportHistory   ExportHistory[]
  connectedMailboxes ConnectedMailbox[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Country {
  id     String  @id @default(cuid())
  name   String  @unique
  code   String  @unique
  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(cuid())
  countryId String   @map("country_id")
  name      String
  slug      String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, slug])
  @@index([slug])
  @@map("states")
}

model City {
  id      String @id @default(cuid())
  stateId String @map("state_id")
  name    String
  slug    String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, slug])
  @@index([slug])
  @@index([name])
  @@map("cities")
}

model Category {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  businesses Business[]

  @@index([slug])
  @@map("categories")
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

model Business {
  id            String         @id @default(cuid())
  slug          String         @unique
  businessName  String         @map("business_name")
  nameSort      String?        @map("name_sort")
  owner         String?
  categoryId    String?        @map("category_id")
  categoryName  String         @map("category")
  website       String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?        @map("postal_code")
  latitude      Float?
  longitude     Float?
  rating        Float?
  reviewsCount  Int            @default(0) @map("reviews_count")
  googleMapsUrl String?        @map("google_maps_url")
  source        String?        @default("manual")
  status        BusinessStatus @default(APPROVED)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  savedBy       SavedLead[]

  @@index([businessName])
  @@index([nameSort])
  @@index([categoryName])
  @@index([city])
  @@index([state])
  @@index([country])
  @@index([phone])
  @@index([website])
  @@index([rating])
  @@index([reviewsCount])
  @@index([createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([city, categoryName])
  @@index([state, categoryName])
  @@map("businesses")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  keyword      String?
  city         String?
  category     String?
  totalResults Int      @default(0) @map("total_results")
  searchedAt   DateTime @default(now()) @map("searched_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([searchedAt])
  @@index([userId])
  @@map("search_history")
}

/** Desktop tool download tracking (website accounts only). */
model Download {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  toolName  String   @map("tool_name")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolName])
  @@index([createdAt])
  @@map("downloads")
}

/** User-bookmarked businesses from Lead Finder. */
model SavedLead {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, createdAt])
  @@index([businessId])
  @@map("saved_leads")
}

enum ExportFormat {
  CSV
  XLSX
  JSON
}

/** Audit log of lead exports (file built client-side; metadata stored here). */
model ExportHistory {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  format      ExportFormat
  rowCount    Int          @map("row_count")
  source      String       @default("search")
  filtersJson String?      @map("filters_json") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([format])
  @@map("export_history")
}

/**
 * Email Finder Phase 1: remembered domain patterns + catch-all cache.
 * confirmedPattern uses keys like "first.last" from the pattern table.
 */
model DomainPattern {
  id               String    @id @default(cuid())
  domain           String    @unique
  confirmedPattern String?   @map("confirmed_pattern")
  confidenceCount  Int       @default(0) @map("confidence_count")
  isCatchAll       Boolean?  @map("is_catch_all")
  lastChecked      DateTime? @map("last_checked")
  /** Last time a third-party API confirmed a mailbox for this domain pattern */
  lastApiVerified  DateTime? @map("last_api_verified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([domain])
  @@index([lastChecked])
  @@index([lastApiVerified])
  @@map("domain_patterns")
}

/** Audit log of paid Email Finder verification API calls (cost control). */
model EmailFinderApiLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  domain     String
  email      String
  status     String
  provider   String
  costCredits Int     @default(1) @map("cost_credits")
  rawJson    String?  @map("raw_json") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([domain])
  @@index([userId, createdAt])
  @@map("email_finder_api_logs")
}

/** Monthly free-tier usage for Email Finder bulk (signed-in). */
model EmailFinderUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  monthKey  String   @map("month_key")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, monthKey])
  @@index([userId])
  @@map("email_finder_usage")
}

/** Encrypted mailbox credentials for Email Warmup (app password / SMTP-IMAP). */
model ConnectedMailbox {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  email                 String
  provider              String    // gmail | outlook | custom
  displayName           String?   @map("display_name")
  /** Envelope-encrypted credential blob (JSON). Never plaintext app passwords. */
  encryptedCredentials  String    @map("encrypted_credentials") @db.Text
  keyId                 String    @default("env-v1") @map("key_id")
  status                String    @default("connected") // connected | auth_failed | disconnected
  /** Warmup engine status: active | paused | flagged */
  warmupStatus          String    @default("active") @map("warmup_status")
  rampDay               Int       @default(1) @map("ramp_day")
  totalRampDays         Int       @default(28) @map("total_ramp_days")
  warmupStartedAt       DateTime? @map("warmup_started_at")
  pausedAt              DateTime? @map("paused_at")
  pauseReason           String?   @map("pause_reason")
  dailySendLimit        Int       @default(5) @map("daily_send_limit")
  sendsToday            Int       @default(0) @map("sends_today")
  sendsTodayDate        String?   @map("sends_today_date") // YYYY-MM-DD UTC
  lastVerifiedAt        DateTime? @map("last_verified_at")
  lastAuthError         String?   @map("last_auth_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs             MailboxAuditLog[]
  warmupEvents          WarmupEvent[]
  pendingRescues        WarmupPendingRescue[]

  @@unique([userId, email])
  @@index([userId])
  @@index([status])
  @@index([warmupStatus])
  @@index([lastVerifiedAt])
  @@map("connected_mailboxes")
}

/** Audit trail for mailbox connect/send/read actions (no credential content). */
model MailboxAuditLog {
  id          String   @id @default(cuid())
  mailboxId   String?  @map("mailbox_id")
  userId      String   @map("user_id")
  action      String   // connect | disconnect | smtp_test | imap_test | send | imap_scan | auth_revoked
  messageUid  String?  @map("message_uid")
  detail      String?
  createdAt   DateTime @default(now()) @map("created_at")
  mailbox     ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([mailboxId, createdAt])
  @@index([action, createdAt])
  @@map("mailbox_audit_logs")
}

/**
 * Warmup activity events for analytics dashboard.
 * eventType: sent | delivered_inbox | delivered_spam | rescued | opened | replied | flagged_important | bounced
 */
model WarmupEvent {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  mailboxId            String   @map("mailbox_id")
  eventType            String   @map("event_type")
  messageId            String?  @map("message_id")
  counterpartMailboxId String?  @map("counterpart_mailbox_id")
  counterpartEmail     String?  @map("counterpart_email")
  detail               String?
  createdAt            DateTime @default(now()) @map("created_at")
  mailbox              ConnectedMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([mailboxId, createdAt])
  @@index([eventType, createdAt])
  @@index([mailboxId, eventType, createdAt])
  @@map("warmup_events")
}

/** Delayed spam→inbox rescues (5–30 min after detection so pattern is less bot-like). */
model WarmupPendingRescue {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  mailboxId   String   @map("mailbox_id")
  messageUid  String   @map("message_uid")
  spamFolder  String   @map("spam_folder")
  messageId   String?  @map("message_id")
  executeAt   DateTime @map("execute_at")
  createdAt   DateTime @default(now()) @map("created_at")
  mailbox     ConnectedMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, messageUid, spamFolder])
  @@index([executeAt])
  @@index([mailboxId])
  @@map("warmup_pending_rescues")
}
